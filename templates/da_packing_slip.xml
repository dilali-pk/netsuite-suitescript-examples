<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<!--
  Packing slip template (Advanced PDF/HTML, FreeMarker) with a scannable barcode.
  Use: Customization > Forms > Advanced PDF/HTML Templates > New > Packing Slip,
  switch to Source Code and paste this file.
-->
<pdf>
<head>
    <macrolist>
        <macro id="nlheader">
            <table style="width: 100%;">
                <tr>
                    <td style="width: 55%;">
                        <#if companyInformation.logoUrl?length != 0>
                            <img src="${companyInformation.logoUrl}" style="height: 44px;" />
                        </#if>
                        <p class="company">${companyInformation.companyName}</p>
                        <p class="muted">${companyInformation.addressText}</p>
                    </td>
                    <td style="width: 45%;" align="right">
                        <p class="title">Packing Slip</p>
                        <barcode codetype="code128" showtext="true" value="${record.tranid}" />
                    </td>
                </tr>
            </table>
        </macro>
        <macro id="nlfooter">
            <p class="muted" align="right">Page <pagenumber/> of <totalpages/></p>
        </macro>
    </macrolist>
    <style type="text/css">
        * { font-family: NotoSans, sans-serif; }
        body { font-size: 9pt; color: #222222; }
        p { margin: 0; }
        .company { font-size: 12pt; font-weight: bold; margin-top: 4px; }
        .title { font-size: 18pt; font-weight: bold; margin-bottom: 6px; }
        .muted { color: #666666; font-size: 8pt; }
        .label { color: #666666; font-size: 8pt; text-transform: uppercase; }
        table.meta { width: 100%; margin-top: 10px; }
        table.items { width: 100%; margin-top: 16px; }
        table.items th { background-color: #333333; color: #ffffff; font-weight: bold; padding: 6px; }
        table.items td { padding: 6px; border-bottom: 1px solid #dddddd; }
        td.alt { background-color: #f5f5f5; }
    </style>
</head>
<body header="nlheader" header-height="120pt" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">

    <table class="meta">
        <tr>
            <td style="width: 50%;">
                <p class="label">Ship to</p>
                <p>${record.shipaddress}</p>
            </td>
            <td style="width: 25%;">
                <p class="label">Ship date</p>
                <p>${record.trandate}</p>
                <p class="label" style="margin-top: 8px;">Order</p>
                <p>${record.createdfrom}</p>
            </td>
            <td style="width: 25%;">
                <p class="label">Ship via</p>
                <p>${record.shipmethod}</p>
            </td>
        </tr>
    </table>

    <#if record.item?has_content>
    <table class="items">
        <#list record.item as tranline>
        <#if tranline_index == 0>
        <thead>
            <tr>
                <th align="left" colspan="6">Item</th>
                <th align="left" colspan="10">Description</th>
                <th align="right" colspan="3">Qty shipped</th>
            </tr>
        </thead>
        </#if>
        <#assign rowClass = (tranline_index % 2 == 1)?string("alt", "")>
        <tr>
            <td class="${rowClass}" colspan="6">${tranline.item}</td>
            <td class="${rowClass}" colspan="10">${tranline.description}</td>
            <td class="${rowClass}" colspan="3" align="right">${tranline.quantity}</td>
        </tr>
        </#list>
    </table>
    </#if>

    <#if record.memo?has_content>
    <p class="label" style="margin-top: 24px;">Notes</p>
    <p>${record.memo}</p>
    </#if>

</body>
</pdf>
